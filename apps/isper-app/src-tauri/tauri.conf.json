{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ISPer",
  "version": "0.13.0",
  "identifier": "com.isper.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "url": "index.html",
        "title": "ISPer",
        "width": 460,
        "height": 104,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/sherpa/sherpa-onnx-c-api.dll": "sherpa-onnx-c-api.dll",
      "resources/sherpa/sherpa-onnx-cxx-api.dll": "sherpa-onnx-cxx-api.dll",
      "resources/sherpa/onnxruntime.dll": "onnxruntime.dll",
      "resources/sherpa/onnxruntime_providers_shared.dll": "onnxruntime_providers_shared.dll",
      "resources/sherpa/cargs.dll": "cargs.dll",
      "resources/vcredist/msvcp140.dll": "msvcp140.dll",
      "resources/vcredist/vcruntime140.dll": "vcruntime140.dll",
      "resources/vcredist/vcruntime140_1.dll": "vcruntime140_1.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0MjJFNUVDRjU0MkQ0OTQKUldTVTFFTDE3T1VpVlBVWFJLUi8rUXp4S2pEaldqQjk0dDFmNlFKSEFTNFV6TlpHd084bHhPYU4K",
      "endpoints": [
        "https://github.com/Marcus-Boni/ISPer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
