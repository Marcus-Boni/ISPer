<?xml version="1.0" encoding="utf-8"?>
<!-- Nada vai para o backup em nuvem nem para a transferência entre aparelhos:
     os modelos se baixam de novo, e gravações (a partir da 9.2) são do usuário. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
