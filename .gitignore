# Artefatos de build do Rust (target-cpu: variante sem CUDA do instalador)
/target
/target-cpu

# Instaladores e manifests gerados por scripts/release.ps1
/dist

# Modelos Whisper (grandes demais para o git — baixados sob demanda)
/models

# Schemas gerados pelo Tauri no build
apps/isper-app/src-tauri/gen/

# DLLs do CUDA copiadas para o instalador (centenas de MB — copie do toolkit)
apps/isper-app/src-tauri/resources/

# Saídas temporárias e dados locais (transcrições de teste, banco)
*.log
*.db
/reunioes

# Chave privada de assinatura das atualizações (fica em %USERPROFILE%\.tauri, nunca aqui)
*.key
*.key.pub

# Captura de teste do `loopdump` (7,7 MB) — gerada localmente, nunca versionar
/loopdump.wav
